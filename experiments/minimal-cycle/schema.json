        "orca_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "ENVIRONMENT",
            "HOST_FALLBACK",
            "UNKNOWN"
