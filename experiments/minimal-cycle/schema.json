      "type": "object"
    },
    "failure_classification": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "host_after": {
      "type": "object"
    },
    "host_before": {
      "type": "object"
    },
