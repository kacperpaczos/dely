      "items": {
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "auth": {
