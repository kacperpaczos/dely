            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "OK",
            "FAILED",
            "SKIPPED",
            "TIMEOUT",
            "BLOCKED"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "detail",
        "commands"
      ],
      "type": "object"
