        "properties": {
          "commands": {
            "type": "array"
          },
          "detail": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "OK",
              "FAILED",
              "SKIPPED",
              "TIMEOUT",
              "BLOCKED"
