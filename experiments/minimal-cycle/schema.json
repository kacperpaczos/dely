          "status",
          "commands"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "run_id": {
      "pattern": "^\\d{8}T\\d{6}Z-[0-9a-f]{6}-[0-9a-f]{8}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
