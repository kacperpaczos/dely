        "ERROR",
        "TIMEOUT",
        "CANCELLED",
        "CLEANUP_FAILED",
        "UNKNOWN",
        "BLOCKED"
      ],
      "type": "string"
    },
    "tested_revision": {
      "type": "string"
    },
    "timeout_seconds": {
      "type": "integer"
    },
    "versions": {
      "type": "object"
    },
