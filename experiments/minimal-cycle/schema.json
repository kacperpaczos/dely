      "type": [
        "number",
        "null"
      ]
    },
    "environment": {
      "type": "object"
    },
    "environment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "export": {
      "properties": {
        "artifacts": {
          "type": "array"
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        },
        "missing": {
          "type": "array"
        },
        "receipt_path": {
          "type": [
            "string",
            "null"
          ]
