{
  "description": "Required shape of the manifest one cycle writes to the host. Validated by cycle_runner.manifest, which supports type, required, properties, items, enum, const and pattern.",
  "properties": {
    "admission": {
      "properties": {
        "backend": {
          "type": "string"
        },
        "claim": {
          "type": "object"
        },
        "detail": {
          "type": "string"
        },
        "granted": {
          "type": "boolean"
        },
        "occupants": {
          "type": "array"
        },
        "policy": {
          "properties": {
            "budget": {
              "type": [
                "object",
                "null"
              ]
            },
            "effective_max_active": {
              "minimum": 1,
              "type": "integer"
            },
            "max_active": {
              "minimum": 1,
              "type": "integer"
            },
            "parallel": {
              "type": "boolean"
            }
          },
          "required": [
            "parallel",
            "max_active",
            "effective_max_active"
          ],
          "type": "object"
        },
        "released": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "OK",
            "FAILED",
            "SKIPPED",
            "TIMEOUT",
            "BLOCKED"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "granted",
        "backend",
        "policy",
        "claim",
        "released",
        "detail"
      ],
      "type": "object"
    },
    "artifact_root": {
      "type": "string"
    },
