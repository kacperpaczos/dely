        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "expected_marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "OK",
            "FAILED",
            "SKIPPED",
            "TIMEOUT",
            "BLOCKED"
